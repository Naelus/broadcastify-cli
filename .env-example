# Broadcastify premium website login (not the official API).
BROADCASTIFY_USERNAME="yourUserName"
BROADCASTIFY_PASSWORD="yourPassword"

# Optional installation-local archive request ledger path. Normally leave this
# unset: desktop packages and each Web/CLI installation choose their own durable
# path. Do not point multiple installations at this over a network share.
# BROADCASTIFY_QUOTA_LEDGER=""

# Read-only token used to download the gated pyannote diarization model.
HUGGINGFACE_TOKEN="yourReadTokenForPyannote"

# Optional local runtime/model overrides. Leave blank to use auto-discovery.
WHISPER_CPP_PATH=""
WHISPER_CPP_MODEL_PATH=""
WHISPER_CPP_VAD_MODEL_PATH=""
# Optional Linux immutable-host path. The image must already be pulled; the app
# never pulls it automatically. Prefer a verified tag/digest from the official image.
WHISPER_CPP_CONTAINER_IMAGE=""
BROADCASTIFY_CONTAINER_RUNTIME=""
WHISPER_CPP_CONTAINER_BACKEND="vulkan"
WHISPER_CPP_CONTAINER_DEVICE="/dev/dri"
WHISPER_CPP_CONTAINER_GROUP_ID=""
WHISPER_CPP_CONTAINER_EXECUTABLE="/app/build/bin/whisper-cli"
OPENVINO_WHISPER_MODEL_PATH=""
WINDOWS_ML_HELPER_PATH=""
WINDOWS_ML_WHISPER_MODEL_PATH=""
# Optional Qwen3-ASR overrides. The normal UI-managed install needs none.
QWEN3_ASR_MODEL_PATH=""
QWEN3_ASR_VAD_PATH=""
QWEN3_ASR_THREADS=""
BROADCASTIFY_MODEL_DIR=""
LLAMA_SERVER_PATH=""
BROADCASTIFY_RUNTIME_DIR=""
FFMPEG_PATH=""

# Optional Web-host deployment preset. This resolves the browser's Automatic
# profile to runtimes/models already installed by that image. Explicit custom
# profile selections are never replaced.
BROADCASTIFY_DEFAULT_HARDWARE_PROFILE=""
BROADCASTIFY_DEFAULT_WHISPER_MODEL=""
BROADCASTIFY_DEFAULT_ASR_ENGINE=""
BROADCASTIFY_DEFAULT_DEVICE=""
BROADCASTIFY_DEFAULT_DIARIZATION_ENGINE=""
BROADCASTIFY_DEFAULT_DIARIZATION_DEVICE=""
BROADCASTIFY_DEFAULT_BATCH_SIZE=""

# Trusted-LAN archive reuse. Clients try configured/discovered peers before any
# Broadcastify archive download. Serving is off unless explicitly enabled.
BROADCASTIFY_LAN_SYNC_ENABLED="true"
BROADCASTIFY_LAN_DISCOVERY_ENABLED="true"
BROADCASTIFY_LAN_PEERS=""
BROADCASTIFY_LAN_SHARING="false"
# Coordinate one upstream archive-media producer per scope/feed/day. This avoids
# duplicate source blocks; it does not share or enlarge request-ledger capacity.
BROADCASTIFY_LAN_QUEUE_ENABLED="true"
# Use the same non-secret label for peers in one cache/coordination pool.
BROADCASTIFY_LAN_QUOTA_SCOPE="default"
# Required for discovery when a container's internal address is not reachable.
BROADCASTIFY_LAN_ADVERTISE_URL=""
# Optional shared secret for raw-block inventory and transfers. Every peer that
# participates in that private pool must use the same value.
BROADCASTIFY_LAN_SYNC_KEY=""
BROADCASTIFY_LAN_DISCOVERY_PORT="48765"
# Expert queue timing controls:
# BROADCASTIFY_LAN_QUEUE_LEASE_SECONDS="90"
# BROADCASTIFY_LAN_QUEUE_RESULT_SECONDS="86400"
# BROADCASTIFY_LAN_QUEUE_ROLLING_RESULT_SECONDS="300"
# BROADCASTIFY_LAN_QUEUE_MAX_WAIT_SECONDS="1800"

# Optional analysis provider. `local` never sends transcript text away.
ANALYSIS_PROVIDER="local"
ANALYSIS_MODEL=""
# `cpu` forces managed llama.cpp to avoid every GPU; `auto` allows offload.
ANALYSIS_DEVICE="auto"
ANALYSIS_ENDPOINT=""
ANALYSIS_API_KEY_ENV="OPENAI_API_KEY"
OPENAI_API_KEY=""
CODEX_CLI_PATH=""
ALLOW_EXTERNAL_ANALYSIS="false"
