# Broadcastify premium website login (not the official API).
BROADCASTIFY_USERNAME="yourUserName"
BROADCASTIFY_PASSWORD="yourPassword"

# Read-only token used to download the gated pyannote diarization model.
HUGGINGFACE_TOKEN="yourReadTokenForPyannote"

# Optional local runtime/model overrides. Leave blank to use auto-discovery.
WHISPER_CPP_PATH=""
WHISPER_CPP_MODEL_PATH=""
OPENVINO_WHISPER_MODEL_PATH=""
BROADCASTIFY_MODEL_DIR=""
LLAMA_SERVER_PATH=""
FFMPEG_PATH=""
