<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BroadcastifyCli.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BroadcastifyCli.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Broadcastify Desktop"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Broadcastify Desktop" Subtitle="Local radio archive intelligence" />

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryNavigationItem" Content="Local library" Tag="library" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ArchiveNavigationItem" Content="New archive" Tag="archive">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ReviewNavigationItem" Content="Review &amp; ask" Tag="review">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AreaNavigationItem" Content="Area watch" Tag="area">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE707;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="CredentialsNavigationItem" Content="Credentials" Tag="credentials">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Local library -->
                    <Grid x:Name="LibraryPage" Padding="26,20,26,18" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Local library" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="See every retained feed-day, what is finished, and the exact next step—without touching Broadcastify unless a download is incomplete."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="ResumeAllLibraryButton" Content="Resume all"
                                        Click="ResumeAllLibrary_Click"
                                        ToolTipService.ToolTip="Finish local-only work first, then use the guarded rolling archive allowance one day at a time." />
                                <Button x:Name="RefreshLibraryButton" Content="Refresh library"
                                        Click="RefreshLibrary_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                                <StackPanel Spacing="3"><TextBlock Text="Feeds" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="LibraryFeedCountText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                                <StackPanel Spacing="3"><TextBlock Text="Local days" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="LibraryDayCountText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                                <StackPanel Spacing="3"><TextBlock Text="Need a next step" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="LibraryAttentionCountText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16">
                                <StackPanel Spacing="3"><TextBlock Text="Ready to review" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="LibraryCompleteCountText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="LibrarySearchBox" PlaceholderText="Filter by feed, agency, or date"
                                            QueryIcon="Find" TextChanged="LibraryFilter_Changed" />
                            <ComboBox x:Name="LibraryFilterCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="LibraryFilterCombo_SelectionChanged">
                                <ComboBoxItem Content="All local days" Tag="all" />
                                <ComboBoxItem Content="Needs attention" Tag="attention" />
                                <ComboBoxItem Content="Ready to review" Tag="complete" />
                                <ComboBoxItem Content="Needs download" Tag="network" />
                            </ComboBox>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" MinWidth="330" />
                                    <ColumnDefinition Width="6*" MinWidth="390" />
                                </Grid.ColumnDefinitions>
                                <ListView x:Name="LibraryList" SelectionMode="Single"
                                          SelectionChanged="LibraryList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LibraryDay">
                                            <StackPanel Padding="12,10" Spacing="5">
                                                <TextBlock Text="{x:Bind FeedName}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DateAndStatus}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind PipelinePercent}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind NextStep}"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind StorageSummary}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               TextAlignment="Right" MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind StorageSummary}" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="LibraryEmptyText" Text="No local archive days match this view."
                                           Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Border Grid.Column="1" BorderThickness="1,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <StackPanel x:Name="LibraryDetailEmptyPanel" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Spacing="8" Margin="28">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="30"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Choose a local day to inspect it."
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Its audio, transcript, speaker labels, and analysis state will appear here."
                                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Grid x:Name="LibraryDetailPanel" Visibility="Collapsed" Padding="18,14,18,14" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock x:Name="LibraryDetailTitleText" Style="{StaticResource SubtitleTextBlockStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="LibraryDetailSubtitleText"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button x:Name="LibraryDeleteFeedButton" Grid.Column="1"
                                                        Content="Delete feed" VerticalAlignment="Top"
                                                        Click="LibraryDeleteFeed_Click"
                                                        ToolTipService.ToolTip="Permanently delete this feed's retained audio and derived local evidence." />
                                            </Grid>
                                            <InfoBar x:Name="LibraryDetailInfoBar" Grid.Row="1" IsOpen="True"
                                                     IsClosable="False" Severity="Informational" />
                                            <TabView Grid.Row="2" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
                                                <TabViewItem Header="Processing" IsClosable="False">
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="4,8,8,4">
                                                        <StackPanel Spacing="10">
                                                            <ProgressBar x:Name="LibraryDetailProgress" Minimum="0" Maximum="100" />
                                                            <TextBlock x:Name="LibraryDetailStatusText" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Border Padding="12,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                                <StackPanel Spacing="8">
                                                                    <TextBlock Text="Processing timeline" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                    <TextBlock x:Name="LibraryDownloadStageText" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="LibraryCombineStageText" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="LibraryTranscriptStageText" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="LibraryDiarizationStageText" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="LibraryAnalysisStageText" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Button x:Name="LibraryCheckSourceButton"
                                                                    Content="Check for new source audio"
                                                                    HorizontalAlignment="Left"
                                                                    Click="LibraryCheckSource_Click"
                                                                    ToolTipService.ToolTip="Recheck this feed and date, reuse retained blocks, and download only missing source audio within the rolling quota." />
                                                            <TextBlock x:Name="LibraryPathText" TextWrapping="Wrap"
                                                                       IsTextSelectionEnabled="True"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabViewItem>
                                                <TabViewItem Header="Listen &amp; transcript" IsClosable="False">
                                                    <Grid Padding="4,8,8,4" RowSpacing="9">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock x:Name="LibraryAudioStatusText" Text="No combined audio is available."
                                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <MediaPlayerElement x:Name="LibraryAudioPlayer" Grid.Row="1" Height="72"
                                                                            AreTransportControlsEnabled="True" />
                                                        <TextBox x:Name="LibraryTranscriptPreviewText" Grid.Row="2" IsReadOnly="True"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                                                 PlaceholderText="No transcript is available yet."
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                                        <Button x:Name="LibraryOpenTranscriptButton" Grid.Row="3"
                                                                Content="Open full transcript" HorizontalAlignment="Left"
                                                                Click="LibraryOpenTranscript_Click" />
                                                    </Grid>
                                                </TabViewItem>
                                            </TabView>
                                            <Grid Grid.Row="3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="LibraryDetailPrimaryButton" HorizontalAlignment="Stretch"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Click="LibraryDetailPrimary_Click" />
                                                <Button x:Name="LibraryDetailReviewButton" Grid.Column="1" Content="Open review"
                                                        Click="LibraryDetailReview_Click" />
                                                <Button x:Name="LibrarySpeakerUpgradeButton" Grid.Column="2" Content="Improve speakers"
                                                        Visibility="Collapsed"
                                                        Click="LibrarySpeakerUpgrade_Click"
                                                        ToolTipService.ToolTip="Replace fast preview labels with Community-1 without repeating transcription." />
                                                <Button x:Name="LibraryOpenFolderButton" Grid.Column="3" Content="Open folder"
                                                        Click="LibraryOpenFolder_Click" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- New archive -->
                    <Grid x:Name="ArchivePage" Visibility="Collapsed" Padding="26,20,26,18" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="New archive" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Find a feed using the same kinds of searches as the website, then acquire a guarded date range. Processing settings live in Settings."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Find a feed" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="City, agency, county, or ZIP" QueryIcon="Find"
                                                        QuerySubmitted="Search_QuerySubmitted" />
                                        <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Click="Search_Click" />
                                    </Grid>
                                    <ListView x:Name="FeedResults" Grid.Row="2" SelectionMode="Single" SelectionChanged="FeedResults_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:FeedSearchResult">
                                                <Grid Padding="8" ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind LocationAndGenre}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind Description}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                                        <TextBlock Text="{x:Bind FeedLabel}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{x:Bind ListenerSummary}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind Status}" HorizontalAlignment="Right" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="SelectedFeedText" Grid.Row="3" Text="No feed selected"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Archive job" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <DatePicker x:Name="StartDatePicker" Header="Start date" HorizontalAlignment="Stretch" />
                                        <DatePicker x:Name="EndDatePicker" Header="End date" HorizontalAlignment="Stretch" />
                                        <ToggleSwitch x:Name="CombineToggle" Header="Daily audio" OffContent="Keep separate" OnContent="Create combined MP3" Toggled="Combine_Toggled" />
                                        <ToggleSwitch x:Name="KeepOriginalsToggle" Header="Source files" IsOn="True" OffContent="Remove after combine" OnContent="Keep originals" />
                                        <CheckBox x:Name="TranscribeCheckBox" Content="Transcribe locally" IsChecked="True" />
                                        <CheckBox x:Name="DiarizeCheckBox" Content="Add speaker diarization" IsChecked="True" />
                                        <CheckBox x:Name="AnalyzeAfterJobCheckBox" Content="Extract incidents, summarize, and index" IsChecked="True" />
                                        <InfoBar x:Name="ArchiveQuotaInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                                 Title="Checking this installation's archive budget"
                                                 Message="Cached audio and local processing do not consume archive requests." />
                                        <Button x:Name="StartButton" Content="Start archive job" HorizontalAlignment="Stretch"
                                                Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button x:Name="ScheduleFeedButton" Content="Schedule this feed" HorizontalAlignment="Stretch"
                                                    Click="ScheduleFeed_Click" />
                                            <Button x:Name="ManageSchedulesButton" Grid.Column="1" Content="Manage schedules" HorizontalAlignment="Stretch"
                                                    Click="ManageSchedules_Click" />
                                        </Grid>
                                        <InfoBar x:Name="FeedScheduleInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                                 Title="No feed schedules yet"
                                                 Message="Daily schedules run while this desktop app is open; the NAS service can run its own schedules continuously." />
                                        <TextBlock Text="Model, device, speaker, storage, and credential options are in Settings."
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Expander Grid.Row="2" Header="Activity log">
                            <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </Grid>

                    <!-- Review -->
                    <Grid x:Name="ReviewPage" Visibility="Collapsed" Padding="26,20,26,18" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Review &amp; ask" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Audit daily incidents against clips, build a seven-day brief, or ask questions across retained evidence."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Name="AnalysisFeedBox" Header="Feed ID" PlaceholderText="Numeric feed ID" />
                                    <Button x:Name="RefreshAnalysisButton" Grid.Row="1" Content="Refresh saved days" Click="RefreshAnalysis_Click" />
                                    <ListView x:Name="AnalysisDaysList" Grid.Row="2" SelectionMode="Single" SelectionChanged="AnalysisDays_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:AnalysisDay">
                                                <StackPanel Padding="7" Spacing="3">
                                                    <TextBlock Text="{x:Bind FeedAndDate}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind ProcessingSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind SpeakerSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button x:Name="AnalyzeSelectedButton" Content="Analyze" Click="AnalyzeSelected_Click" />
                                        <Button x:Name="ReloadReportButton" Grid.Column="1" Content="Reload" Click="ReloadReport_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <TabView Grid.Column="1" IsAddTabButtonVisible="False">
                                <TabViewItem Header="Daily review" IsClosable="False">
                                    <Grid Padding="4,8,4,4" RowSpacing="9">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock x:Name="SummaryText" Text="Choose a saved day." TextWrapping="Wrap" MaxHeight="126" />
                                        <Grid Grid.Row="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="PriorityFilterCombo" SelectedIndex="2" SelectionChanged="PriorityFilter_SelectionChanged">
                                                <ComboBoxItem Content="Priority 5 only" Tag="5" />
                                                <ComboBoxItem Content="Priority 4–5" Tag="4" />
                                                <ComboBoxItem Content="Priority 3–5" Tag="3" />
                                                <ComboBoxItem Content="All incidents" Tag="1" />
                                            </ComboBox>
                                            <TextBox x:Name="IncidentSearchBox" Grid.Column="1"
                                                     PlaceholderText="Search every priority: shots fired, vehicle description, street…"
                                                     TextChanged="IncidentSearch_TextChanged" />
                                        </Grid>
                                        <ListView x:Name="IncidentList" Grid.Row="2" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:IncidentRecord">
                                                    <Grid Padding="8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Border MinWidth="58" Padding="8,5" CornerRadius="8" Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Top">
                                                            <TextBlock Text="{x:Bind TypeAndPriority}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind TimeAndLocation}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind EvidenceQuoteDisplay}" TextWrapping="Wrap" MaxLines="3"
                                                                       FontStyle="Italic" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ConfidenceSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                                <Button Content="Play exact clip" Click="PlayIncident_Click" />
                                                                <Button Content="Play surrounding context" Click="PlayIncidentContext_Click"
                                                                        ToolTipService.ToolTip="Five minutes before through one minute after the cited segment; surrounding traffic is not itself cited evidence." />
                                                                <Button Content="Export exact clip…" Click="ExportIncidentClip_Click" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="PlaybackStatusText" Grid.Row="3" Text="Choose an incident to audit its exact local clip."
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <MediaPlayerElement x:Name="IncidentPlayer" Grid.Row="4" Height="72" AreTransportControlsEnabled="True" />
                                    </Grid>
                                </TabViewItem>
                                <TabViewItem Header="Weekly brief" IsClosable="False">
                                    <ScrollViewer Padding="8">
                                        <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
                                            <TextBlock Text="Seven-day activity brief" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <TextBlock Text="Uses saved daily incidents and clearly reports missing days." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <DatePicker x:Name="WeekEndingPicker" Header="Week ending" />
                                                <Button x:Name="GenerateWeekButton" Content="Generate weekly brief" VerticalAlignment="Bottom"
                                                        Style="{StaticResource AccentButtonStyle}" Click="GenerateWeek_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="WeekCoverageText" Text="Choose a week ending date." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="WeekSummaryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabViewItem>
                                <TabViewItem Header="Ask the archive" IsClosable="False">
                                    <ScrollViewer Padding="8">
                                        <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
                                            <TextBlock Text="Ask across a date range" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <DatePicker x:Name="QuestionStartDatePicker" Header="Start date" />
                                                <DatePicker x:Name="QuestionEndDatePicker" Grid.Column="1" Header="End date" />
                                                <TextBox x:Name="QuestionBox" Grid.Column="2" Header="Question" MinWidth="360" PlaceholderText="What were the most serious reported events?" />
                                            </Grid>
                                            <Button x:Name="AskButton" Content="Ask locally" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" Click="Ask_Click" />
                                            <TextBlock x:Name="AnswerText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabViewItem>
                            </TabView>
                        </Grid>
                    </Grid>

                    <!-- Area watch -->
                    <Grid x:Name="AreaPage" Visibility="Collapsed" Padding="26,20,26,18" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Area watch" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Choose nearby public-safety feeds explicitly, then rank evidence-backed local assignment leads."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TabView Grid.Row="1" IsAddTabButtonVisible="False">
                            <TabViewItem Header="Feeds &amp; coverage" IsClosable="False">
                                <Grid Padding="6,10,6,4" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBox x:Name="AreaProfileNameBox" Header="Area profile name" PlaceholderText="Regional coverage desk" />
                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ComboBox x:Name="AreaCoverageModeCombo" Header="Coverage" SelectedIndex="0" SelectionChanged="AreaCoverageMode_SelectionChanged">
                                                    <ComboBoxItem Content="Radius from ZIP" Tag="radius" />
                                                    <ComboBoxItem Content="Ordered ZIP list" Tag="zip-list" />
                                                </ComboBox>
                                                <TextBox x:Name="AreaZipCodesBox" Grid.Column="1" Header="Center ZIP" PlaceholderText="5-digit ZIP" />
                                                <Button x:Name="DiscoverAreaFeedsButton" Grid.Column="2" Content="Discover nearest" VerticalAlignment="Bottom" Click="DiscoverAreaFeeds_Click" />
                                            </Grid>
                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <NumberBox x:Name="AreaRadiusBox" Header="Radius (miles)" Value="25" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" />
                                                <NumberBox x:Name="AreaMaxZipCodesBox" Grid.Column="1" Header="ZIP search cap" Value="12" Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" />
                                                <TextBlock Grid.Column="2" Text="Radius mode caches Census ZIP centroids once, checks nearby ZIP areas first, and never starts archive downloads." TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <Grid Grid.Row="3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AreaPublicSafetyOnlyCheckBox" Content="Show public-safety feeds only (recommended)" IsChecked="True"
                                                          Checked="AreaPublicSafetyOnly_Changed" Unchecked="AreaPublicSafetyOnly_Changed" />
                                                <Button Grid.Column="1" Content="Nearest 3" Click="SelectNearestAreaFeeds_Click" />
                                                <Button Grid.Column="2" Content="Clear" Click="ClearAreaFeeds_Click" />
                                            </Grid>
                                            <TextBlock x:Name="AreaFeedSelectionText" Grid.Row="4"
                                                       Text="Discover feeds, then choose the agencies this area watch should monitor."
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ListView x:Name="AreaFeedResults" Grid.Row="5" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True"
                                                      SelectionChanged="AreaFeedResults_SelectionChanged">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="local:FeedSearchResult">
                                                        <Grid Padding="8" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                <TextBlock Text="{x:Bind AreaMatchSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{x:Bind Description}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind FeedLabel}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button x:Name="SaveAreaProfileButton" Grid.Row="6" Content="Save selected nearest-first feeds" Click="SaveAreaProfile_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="12">
                                            <ComboBox x:Name="AreaProfileCombo" Header="Saved area profile" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" SelectionChanged="AreaProfile_SelectionChanged" />
                                            <DatePicker x:Name="AreaStartDatePicker" Header="Start date" HorizontalAlignment="Stretch" />
                                            <DatePicker x:Name="AreaEndDatePicker" Header="End date" HorizontalAlignment="Stretch" />
                                            <Button x:Name="ProcessAreaFeedsButton" Content="Run or resume nearest-first queue" HorizontalAlignment="Stretch"
                                                    Style="{StaticResource AccentButtonStyle}" Click="ProcessAreaFeeds_Click" />
                                            <TextBlock x:Name="AreaQueueStatusText" Text="No retained queue for this profile yet." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Persisted quota-safe queue"
                                                     Message="Save the reviewed feed selection first. The queue resumes cached work, runs nearest feeds first, and stops every lower-priority feed on the first explicit quota response." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabViewItem>
                            <TabViewItem Header="Story leads" IsClosable="False">
                                <Grid Padding="6,10,6,4" RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Evidence-backed assignment leads" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                        <Button x:Name="GenerateAreaDigestButton" Grid.Column="1" Content="Find story leads" Style="{StaticResource AccentButtonStyle}" Click="GenerateAreaDigest_Click" />
                                    </Grid>
                                    <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Warning" Title="Assignment leads, not confirmed events"
                                             Message="Police-radio ASR can be wrong. Verify every quote and clip before publication or subscriber delivery." />
                                    <TextBlock x:Name="AreaCoverageText" Grid.Row="2" Text="Save or choose a profile, then select a date range." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Expander x:Name="AreaSummaryExpander" Grid.Row="3"
                                              Header="Generated assignment brief"
                                              IsExpanded="False" Visibility="Collapsed"
                                              HorizontalAlignment="Stretch">
                                        <ScrollViewer MaxHeight="150">
                                            <TextBlock x:Name="AreaSummaryText" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                        </ScrollViewer>
                                    </Expander>
                                    <Grid Grid.Row="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <StackPanel Padding="12,10,12,4" Spacing="2">
                                                    <TextBlock Text="Ranked leads" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="Select one story to inspect its complete source package."
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ListView x:Name="AreaStoryList" Grid.Row="1" SelectionMode="Single"
                                                          SelectionChanged="AreaStoryList_SelectionChanged">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="local:AreaStory">
                                                            <StackPanel Padding="8,7" Spacing="3">
                                                                <TextBlock Text="{x:Bind Headline}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ScoreSummary}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind TimeAndPlace}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind EvidenceSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock x:Name="AreaStoryDetailEmptyText"
                                                           Text="Choose a ranked lead to inspect its summary, transcript quote, provenance, and exact local clip."
                                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MaxWidth="420" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ScrollViewer x:Name="AreaStoryDetailScroll" Visibility="Collapsed">
                                                    <StackPanel Padding="16,14" Spacing="9">
                                                        <TextBlock x:Name="AreaStoryDetailScoreText" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Name="AreaStoryDetailHeadlineText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="AreaStoryDetailTimePlaceText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="AreaStoryDetailSummaryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <Border Padding="11" CornerRadius="7" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="Why this surfaced" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                <TextBlock x:Name="AreaStoryDetailWhyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock x:Name="AreaStoryDetailEvidenceSummaryText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="AreaStoryDetailAudienceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <ItemsControl x:Name="AreaStoryEvidenceList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="local:AreaStoryReference">
                                                                    <Border Margin="0,4,0,0" Padding="11" CornerRadius="7" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                                        <StackPanel Spacing="5">
                                                                            <TextBlock Text="{x:Bind SourceAndTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                            <TextBlock Text="{x:Bind QuoteDisplay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontStyle="Italic" />
                                                                            <TextBlock Text="{x:Bind ProvenanceSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <Button Content="Play evidence clip" IsEnabled="{x:Bind ClipAvailable}" Click="PlayStoryEvidence_Click" />
                                                                                <Button Content="Export clip…" IsEnabled="{x:Bind ClipAvailable}" Click="ExportStoryEvidence_Click" />
                                                                                <TextBlock Text="{x:Bind ClipStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock x:Name="AreaPlaybackStatusText" Text="Choose a source clip to audit its transcript quote."
                                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <MediaPlayerElement x:Name="AreaStoryPlayer" Height="72" AreTransportControlsEnabled="True" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabViewItem>
                        </TabView>
                    </Grid>

                    <!-- Settings -->
                    <Grid x:Name="SettingsPage" Visibility="Collapsed" Padding="26,20,26,18" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Account, storage, processing, and analysis defaults shared by archive, library, and area jobs."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TabView x:Name="SettingsTabView" Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
                            <TabViewItem x:Name="SetupSettingsTab" Header="Setup" IsClosable="False">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left" Padding="0,4,12,16">
                                        <InfoBar x:Name="SetupReadinessInfoBar" IsOpen="True" IsClosable="False"
                                                 Severity="Informational" Title="Checking this computer"
                                                 Message="No model downloads or archive requests are made by the setup overview." />
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Windows startup and scheduled feeds"
                                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                                <TextBlock Text="Keep the app available to run daily schedules, observe the rolling archive budget, and resume retained work after an interruption."
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ToggleSwitch x:Name="StartWithWindowsToggle"
                                                              Header="Start Broadcastify Desktop when I sign in"
                                                              OnContent="On — recommended"
                                                              OffContent="Off"
                                                              Toggled="StartWithWindows_Toggled" />
                                                <TextBlock x:Name="WindowsStartupStatusText"
                                                           Text="Checking the current Windows startup preference…"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="14">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="Setup at a glance" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                        <TextBlock x:Name="SetupReadinessCountText" Text="Inspecting account, storage, and local engines…"
                                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button x:Name="SetupProfileSelfTestButton" Grid.Column="1" Content="Verify model stages"
                                                            Style="{StaticResource AccentButtonStyle}" Click="ProfileSelfTest_Click"
                                                            ToolTipService.ToolTip="Run transcription, speaker labels, and analysis in sequence using generated input." />
                                                    <ProgressBar x:Name="SetupReadinessProgress" Grid.Column="2" Minimum="0" Maximum="5"
                                                                 Value="0" VerticalAlignment="Center" />
                                                </Grid>

                                                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Premium archive account" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="SetupAccountStateText" Grid.Column="1" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock x:Name="SetupAccountDetailText" Text="Looking for a saved website session or secure login." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Name="SetupAccountActionButton" Grid.Column="2" Content="Sign in" Click="SetupAccount_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Archive storage" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="SetupStorageStateText" Grid.Column="1" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock x:Name="SetupStorageDetailText" Text="Checking the retained audio, transcript, clip, and evidence location." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Review" Click="SetupStorage_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Transcription" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="SetupTranscriptionStateText" Grid.Column="1" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock x:Name="SetupTranscriptionDetailText" Text="Detecting the selected transcription engine and accelerator." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Name="SetupTranscriptionActionButton" Grid.Column="2" Content="Test" Click="SetupTranscription_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Speaker labels" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="SetupDiarizationStateText" Grid.Column="1" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock x:Name="SetupDiarizationDetailText" Text="Checking pyannote, model access, and the selected CUDA or CPU path." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Name="SetupDiarizationActionButton" Grid.Column="2" Content="Test" Click="SetupDiarization_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Event analysis" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="SetupAnalysisStateText" Grid.Column="1" Text="Checking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock x:Name="SetupAnalysisDetailText" Text="Checking local Gemma, an API key, compatible endpoint, or Codex saved login." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Name="SetupAnalysisActionButton" Grid.Column="2" Content="Check" Click="SetupAnalysis_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Detection checks installed components only. Execution tests use generated audio or synthetic text; hosted analysis tests may create minimal provider usage. No Broadcastify quota is used."
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem x:Name="ProcessingSettingsTab" Header="Processing" IsClosable="False">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Left" Padding="0,4,12,16">
                                        <InfoBar x:Name="DiagnosticsInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                                 Title="Checking local models" Message="Inspecting transcription, diarization, and analysis engines…" />

                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="14">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Hardware profile" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="A profile chooses a proven engine for each stage. You can still refine the transcription controls below."
                                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ComboBox x:Name="HardwareProfileComboBox" Header="This computer should use" SelectedIndex="0"
                                                          HorizontalAlignment="Stretch" SelectionChanged="HardwareProfile_SelectionChanged">
                                                    <ComboBoxItem Content="Automatic (recommended)" Tag="auto" />
                                                    <ComboBoxItem Content="NVIDIA CUDA" Tag="cuda" />
                                                    <ComboBoxItem Content="Cross-vendor Vulkan" Tag="vulkan" />
                                                    <ComboBoxItem Content="Intel OpenVINO" Tag="openvino" />
                                                    <ComboBoxItem Content="Windows ML" Tag="windowsml" />
                                                    <ComboBoxItem Content="Fast CPU preview (Qwen3-ASR)" Tag="qwen" />
                                                    <ComboBoxItem Content="CPU only" Tag="cpu" />
                                                </ComboBox>
                                                <TextBlock x:Name="HardwareProfileDescriptionText"
                                                           Text="Detecting the best engines for this computer…" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <InfoBar x:Name="ProfileNextStepsInfoBar" IsOpen="True" IsClosable="False"
                                                         Severity="Informational" Title="Execution proof still needed"
                                                         Message="Run the three generated-input tests before a long unattended job." />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Expander Header="Compare detected profiles" HorizontalAlignment="Stretch">
                                                        <ListView x:Name="HardwareProfileList" SelectionMode="None" IsItemClickEnabled="False"
                                                                  HorizontalContentAlignment="Stretch">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="local:HardwareProfileStatus">
                                                                    <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                            CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                                        <StackPanel Spacing="3">
                                                                            <Grid ColumnSpacing="8">
                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                                                <TextBlock Grid.Column="1" Text="{x:Bind StateText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                            </Grid>
                                                                            <TextBlock Text="{x:Bind StageSummary}" TextWrapping="Wrap" FontSize="12"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                            <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" FontSize="12"
                                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                            <TextBlock Text="{x:Bind NextStepSummary}" TextWrapping="Wrap" FontSize="12"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Expander>
                                                    <Button x:Name="ProfileNextActionButton" Grid.Column="1" Content="Complete setup"
                                                            Visibility="Collapsed" Click="ProfileNextAction_Click" />
                                                    <Button x:Name="ProfileSelfTestButton" Grid.Column="2" Content="Verify profile"
                                                            Style="{StaticResource AccentButtonStyle}" Click="ProfileSelfTest_Click"
                                                            ToolTipService.ToolTip="Run transcription, speaker labels, and analysis in sequence using generated input." />
                                                    <Button x:Name="DiagnosticsRefreshButton" Grid.Column="3" Content="Refresh check"
                                                            Click="RefreshDiagnostics_Click" />
                                                </Grid>
                                                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        CornerRadius="8" Padding="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Packaged CUDA runtime" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="ManagedRuntimeStateText" Grid.Column="1" Text="Checking"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock x:Name="ManagedRuntimeDetailText"
                                                                       Text="An explicit managed install removes the source checkout and separate Python requirement."
                                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock x:Name="ManagedRuntimeSourceText"
                                                                       Text="Pinned wheels from PyPI and the official PyTorch CUDA 12.8 index; package licenses and SHA-256 provenance are retained."
                                                                       TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Name="ManagedRuntimeInstallButton" Grid.Column="1" Content="Check runtime"
                                                                Click="ManagedRuntimeInstall_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="Transcription &amp; speakers" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                        <TextBlock Text="The hardware profile supplies safe engine defaults. Most jobs only need a transcription model and batch size."
                                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                                        <Button x:Name="AsrPrepareButton" Content="Prepare &amp; test model"
                                                                Visibility="Collapsed" Click="AsrPrepare_Click"
                                                                ToolTipService.ToolTip="Explicitly acquire the selected portable model, save its managed path, then prove a local decode." />
                                                        <Button x:Name="AsrSelfTestButton" Content="Test engine"
                                                                Click="AsrSelfTest_Click" ToolTipService.ToolTip="Run a local execution check on generated silence. This proves the runtime path, not radio accuracy." />
                                                        <Button x:Name="DiarizationSelfTestButton" Content="Test speakers"
                                                                Click="DiarizationSelfTest_Click" ToolTipService.ToolTip="Run the selected local speaker engine on generated audio. A first explicit test may download its pinned model." />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ModelComboBox" Header="Transcription model" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="turbo" /><ComboBoxItem Content="distil-large-v3" /><ComboBoxItem Content="large-v3" /><ComboBoxItem Content="medium" /><ComboBoxItem Content="small" /><ComboBoxItem Content="base" /><ComboBoxItem Content="tiny" /><ComboBoxItem Content="qwen3-asr-0.6b-int8" />
                                                    </ComboBox>
                                                    <NumberBox x:Name="BatchSizeBox" Grid.Column="1" Header="ASR / speaker batch" Value="8" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox x:Name="DiarizationEngineComboBox" Grid.Column="2" Header="Speaker-label engine" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Community-1 — accuracy default" Tag="community-1" />
                                                        <ComboBoxItem Content="Fast portable preview — CPU" Tag="sherpa-onnx" />
                                                    </ComboBox>
                                                </Grid>
                                                <TextBlock Text="Fast portable preview is much faster on CPU but can miss short radio turns. Preview labels remain upgradeable to Community-1 without repeating transcription."
                                                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Expander x:Name="AdvancedProcessingExpander" Header="Advanced engine overrides and speaker tuning" HorizontalAlignment="Stretch">
                                                    <StackPanel Spacing="12" Padding="0,8,0,4">
                                                        <TextBlock Text="Changing the hardware profile resets these overrides to a compatible combination."
                                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <ComboBox x:Name="AsrEngineComboBox" Header="Transcription engine" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Recommended" Tag="auto" />
                                                                <ComboBoxItem Content="faster-whisper" Tag="faster-whisper" />
                                                                <ComboBoxItem Content="whisper.cpp" Tag="whisper.cpp" />
                                                                <ComboBoxItem Content="OpenVINO GenAI" Tag="openvino" />
                                                                <ComboBoxItem Content="Windows ML" Tag="windows-ml" />
                                                                <ComboBoxItem Content="Qwen3-ASR (fast CPU preview)" Tag="qwen3-asr" />
                                                            </ComboBox>
                                                            <ComboBox x:Name="DeviceComboBox" Grid.Column="1" Header="Transcription accelerator" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Automatic" Tag="auto" />
                                                                <ComboBoxItem Content="NVIDIA CUDA" Tag="cuda" />
                                                                <ComboBoxItem Content="Cross-vendor Vulkan" Tag="vulkan" />
                                                                <ComboBoxItem Content="OpenVINO (auto)" Tag="openvino-auto" />
                                                                <ComboBoxItem Content="OpenVINO GPU" Tag="openvino-gpu" />
                                                                <ComboBoxItem Content="OpenVINO NPU" Tag="openvino-npu" />
                                                                <ComboBoxItem Content="CPU" Tag="cpu" />
                                                            </ComboBox>
                                                            <ComboBox x:Name="DiarizationDeviceComboBox" Grid.Column="2" Header="Speaker-label accelerator" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Automatic" Tag="auto" />
                                                                <ComboBoxItem Content="NVIDIA CUDA (Community-1)" Tag="cuda" />
                                                                <ComboBoxItem Content="CPU" Tag="cpu" />
                                                            </ComboBox>
                                                        </Grid>
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <NumberBox x:Name="GpuIndexBox" Header="GPU index" Value="0" Minimum="0" Maximum="15" SpinButtonPlacementMode="Compact" />
                                                            <NumberBox x:Name="MinimumSpeakersBox" Grid.Column="1" Header="Minimum speakers (0 = detect)" Value="2" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact" />
                                                            <NumberBox x:Name="MaximumSpeakersBox" Grid.Column="2" Header="Maximum speakers (0 = detect)" Value="8" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact" />
                                                        </Grid>
                                                        <TextBox x:Name="AsrModelPathBox" Header="Optional engine-specific model path"
                                                                 PlaceholderText="Leave blank to use the engine's managed model cache" />
                                                    </StackPanel>
                                                </Expander>
                                                <InfoBar x:Name="HuggingFaceProcessingInfoBar" IsOpen="True" IsClosable="False"
                                                         Severity="Informational" Title="Checking Hugging Face model access"
                                                         Message="Manage the encrypted read token under Credentials.">
                                                    <InfoBar.ActionButton>
                                                        <Button Content="Manage token" Click="ManageHuggingFaceToken_Click" />
                                                    </InfoBar.ActionButton>
                                                </InfoBar>
                                                <InfoBar x:Name="AsrSelfTestInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                                         Title="Selected transcription engine not tested this session"
                                                         Message="The engine check decodes generated silence and may download a managed model. It proves local execution, not radio-word accuracy." />
                                                <InfoBar x:Name="DiarizationSelfTestInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                                         Title="Speaker-label engine not tested this session"
                                                         Message="The explicit test runs the selected local engine on generated audio and may download its pinned model once." />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Library &amp; downloads" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="OutputFolderBox" Header="Archive library folder" Text="archives" />
                                                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PythonRuntimePathBox"
                                                             Header="Optional Python runtime for CUDA or Community-1"
                                                             PlaceholderText="Leave blank to use the bundled portable runtime"
                                                             Description="Choose python.exe from an environment containing broadcastify-cli and the selected optional audio packages. Restart the app after changing this."
                                                             Loaded="PythonRuntimePathBox_Loaded" />
                                                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowsePythonRuntime_Click" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Use bundled runtime" Click="ClearPythonRuntime_Click" />
                                                    <TextBlock x:Name="PythonRuntimeStatusText"
                                                               Text="Checking the active Python worker…"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <NumberBox x:Name="DownloadJobsBox" Header="Download workers" Value="1" Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact" />
                                                <ToggleSwitch x:Name="LanSyncToggle" IsOn="True"
                                                              Header="Reuse original archive blocks from trusted-LAN peers before Broadcastify" />
                                                <ToggleSwitch x:Name="LanDiscoveryToggle" IsOn="True"
                                                              Header="Find archive peers automatically on this LAN" />
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                                    <ToggleSwitch x:Name="LanShareToggle" IsOn="True"
                                                                  Header="Seed original blocks and join the shared LAN download queue"
                                                                  OffContent="Consumer only" OnContent="Peer producer" />
                                                    <NumberBox x:Name="LanSharePortBox" Grid.Column="1"
                                                               Header="LAN peer port" Value="8766" Minimum="1024" Maximum="65535"
                                                               SpinButtonPlacementMode="Compact" />
                                                </Grid>
                                                <TextBox x:Name="LanPeerUrlsBox"
                                                         Header="Optional trusted-LAN peer app URLs"
                                                         PlaceholderText="http://10.0.0.25:8765"
                                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                                         Description="One numeric private-address app URL per line. Feed/day leases elect one upstream downloader; raw blocks can come from any peer and every transfer is SHA-256 verified." />
                                                <InfoBar x:Name="LanShareInfoBar" IsOpen="True" IsClosable="False"
                                                         Severity="Informational" Title="Checking shared LAN queue"
                                                         Message="Only original source blocks participate; credentials, transcripts, and analysis remain local." />
                                                <TextBlock Text="These non-secret processing choices are saved for this Windows account when the app closes. Secrets stay in .env or this session unless you explicitly choose Windows Credential Locker."
                                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem x:Name="AnalysisSettingsTab" Header="Analysis &amp; AI" IsClosable="False">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left" Padding="0,4,12,16">
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Event analysis" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="Local Gemma is the private default. Hosted APIs and Codex are opt-in and use the same evidence and clip checks."
                                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="AnalysisProviderComboBox" Header="Analysis provider" SelectedIndex="0"
                                                              HorizontalAlignment="Stretch" SelectionChanged="AnalysisProvider_SelectionChanged">
                                                        <ComboBoxItem Content="Local Gemma via llama.cpp (recommended)" Tag="local" />
                                                        <ComboBoxItem Content="OpenAI Responses API" Tag="openai-responses" />
                                                        <ComboBoxItem Content="OpenAI-compatible /v1 endpoint" Tag="openai-compatible" />
                                                        <ComboBoxItem Content="Codex CLI saved login" Tag="codex-cli" />
                                                    </ComboBox>
                                                    <TextBox x:Name="AnalysisModelBox" Grid.Column="1" Header="Model"
                                                             PlaceholderText="Provider default when blank" />
                                                </Grid>
                                                <TextBox x:Name="AnalysisEndpointBox" Header="Optional endpoint"
                                                         PlaceholderText="Managed locally, or enter a provider URL ending in /v1"
                                                         TextChanged="AnalysisEndpoint_TextChanged" />
                                                <ComboBox x:Name="AnalysisDeviceComboBox" Header="Managed local analysis device"
                                                          SelectedIndex="0" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="Automatic accelerator offload" Tag="auto" />
                                                    <ComboBoxItem Content="CPU only — do not use a GPU" Tag="cpu" />
                                                </ComboBox>
                                                <ToggleSwitch x:Name="AllowExternalAnalysisToggle"
                                                              Header="Allow transcript excerpts to leave this computer"
                                                              Toggled="AllowExternalAnalysis_Toggled" />
                                                <InfoBar x:Name="AnalysisProviderInfoBar" IsOpen="True" IsClosable="False"
                                                         Severity="Success" Title="Private local analysis"
                                                         Message="Transcript text stays on this computer." />
                                                <Expander Header="Credentials and Codex executable" HorizontalAlignment="Stretch">
                                                    <StackPanel Spacing="10" Padding="0,8,0,4">
                                                        <PasswordBox x:Name="AnalysisApiKeyBox" Header="API key for this session"
                                                                     PlaceholderText="Optional when the environment variable below is set"
                                                                     PasswordRevealMode="Peek" />
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <CheckBox x:Name="RememberAnalysisApiKeyCheckBox"
                                                                      Content="Remember this key in Windows Credential Locker" />
                                                            <Button Content="Forget saved key" Click="ClearAnalysisKey_Click" />
                                                        </StackPanel>
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBox x:Name="AnalysisApiKeyEnvironmentBox" Header="API key environment variable"
                                                                     Text="OPENAI_API_KEY" />
                                                            <TextBox x:Name="CodexCliPathBox" Grid.Column="1" Header="Optional Codex CLI path"
                                                                     PlaceholderText="Leave blank for automatic discovery" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Expander>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button x:Name="AnalysisProviderCheckButton" Content="Check provider"
                                                            Click="CheckAnalysisProvider_Click" />
                                                    <Button x:Name="AnalysisModelTestButton" Grid.Column="1" Content="Test model"
                                                            Click="AnalysisSelfTest_Click"
                                                            ToolTipService.ToolTip="Generate a tiny structured response. Local models may download; hosted providers may create minimal usage." />
                                                    <TextBlock x:Name="AnalysisProviderStatusText" Grid.Column="2"
                                                               Text="Local engine readiness is also included in Processing → hardware check."
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                                <InfoBar x:Name="AnalysisSelfTestInfoBar" IsOpen="True" IsClosable="False"
                                                         Severity="Informational" Title="Analysis model not tested this session"
                                                         Message="The explicit test loads the selected model and generates a tiny structured response from synthetic text." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>

                            <TabViewItem x:Name="AccountSettingsTab" Header="Credentials" IsClosable="False">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left" Padding="0,4,12,16">
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Broadcastify account" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                <InfoBar x:Name="AuthInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                                         Title="Premium archive access" Message="A saved session, Windows Credential Locker login, or private bundled .env can refresh access.">
                                                    <InfoBar.ActionButton><Button Content="Sign in" Click="SignIn_Click" /></InfoBar.ActionButton>
                                                </InfoBar>
                                                <TextBlock x:Name="SettingsAuthStatusText" Text="Checking saved login…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Sign in or replace saved login" Click="SignIn_Click" />
                                                    <Button x:Name="ClearSavedLoginButton" Content="Forget saved login" Click="ClearSavedLogin_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Hugging Face model access" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                <TextBlock Text="A read token is used only to download gated local models such as Community-1 speaker diarization."
                                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <PasswordBox x:Name="HuggingFaceTokenBox" Header="Enter a new Hugging Face read token"
                                                             PlaceholderText="hf_… — leave blank to keep the saved token"
                                                             PasswordRevealMode="Peek"
                                                             PasswordChanged="HuggingFaceToken_Changed" />
                                                <TextBlock x:Name="HuggingFaceCredentialStatusText"
                                                           Text="Checking Windows Credential Locker…"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="SaveHuggingFaceTokenButton" Content="Save encrypted token" Click="SaveHuggingFaceToken_Click" />
                                                    <Button x:Name="ClearHuggingFaceTokenButton" Content="Forget saved token" Click="ClearHuggingFaceToken_Click" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <HyperlinkButton Content="Create a read token"
                                                                     NavigateUri="https://huggingface.co/settings/tokens" />
                                                    <HyperlinkButton Content="Token documentation"
                                                                     NavigateUri="https://huggingface.co/docs/hub/en/security-tokens" />
                                                    <HyperlinkButton Content="Accept Community-1 terms"
                                                                     NavigateUri="https://huggingface.co/pyannote/speaker-diarization-community-1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Private build environment" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                <TextBlock x:Name="SettingsEnvironmentText" Text="Checking bundled environment…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="Private builds can include the ignored repository .env so this computer starts signed in. Public builds never copy it."
                                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>
                        </TabView>
                    </Grid>

                    <!-- Persistent task status -->
                    <Border Grid.Row="1" Padding="18,9" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="JobProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" />
                            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" IsEnabled="False" Click="Cancel_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
